NODE_ENV=development
PORT=3000
HOST=0.0.0.0
WEB_PORT=5173
STORYBOOK_PORT=6006
PREVIEW_PORT=4173
E2E_PORT=3210
COOKIE_SECRET=replace-with-at-least-32-random-characters
PUBLIC_ORIGIN=http://localhost:5173
COLYSEUS_PATH=/colyseus
LOBBY_MAX_CLIENTS=8
CREATE_ROOM_PLAYER_RATE_LIMIT=10
CREATE_ROOM_ADDRESS_RATE_LIMIT=60
JOIN_ROOM_PLAYER_RATE_LIMIT=20
JOIN_ROOM_ADDRESS_RATE_LIMIT=120
# Shorten game round timings in integration/E2E suites
E2E_TEST_MODE=false
# Optional drawing-turn override for deterministic E2E runs
E2E_TURN_DURATION_MS=
# Deadline for all roster players to arrive in a registered game room
CAPITAL_PIN_TRANSITION_TIMEOUT_MS=15000
LOG_LEVEL=info

# Web (Vite)
VITE_COLYSEUS_PATH=/colyseus
# Optional MapLibre style URL for Capital Pin (defaults to OpenFreeMap)
VITE_MAP_STYLE_URL=
